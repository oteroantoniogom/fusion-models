  "description": "MCP server that generates Disler-style fusion-harness README SVGs (palette, cards, flow animations).",
  "license": "MIT",
  "author": "oteroantoniogom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oteroantoniogom/fusion-svg-mcp.git"
  },
